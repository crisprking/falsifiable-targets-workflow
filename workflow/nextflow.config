manifest {
    name = 'falsifiable-targets-workflow'
    description = 'Parallel drug-target audit workflow'
    version = '1.0.0'
    nextflowVersion = '>=23.10.0'
}

params {
    claims_dir = "${projectDir}/claims"
    reports_dir = "${projectDir}/reports"
    offline = false
    skip_sentinel = false
}

profiles {
    standard { process.executor = 'local' }
    docker {
        docker.enabled = true
        process.container = 'falsifiable-targets:latest'
    }
    singularity {
        singularity.enabled = true
        process.container = 'falsifiable-targets.sif'
    }
    slurm { process.executor = 'slurm'; process.queue = 'normal' }
    sge   { process.executor = 'sge' }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = 'falsifiable-targets-queue'
        aws.region = 'us-east-1'
    }
    gcp { process.executor = 'google-batch' }
    test { params.claims_dir = "${projectDir}/examples"; params.offline = true }
}

timeline { enabled = true; file = "${params.reports_dir}/timeline.html" }
report   { enabled = true; file = "${params.reports_dir}/report.html" }
trace    { enabled = true; file = "${params.reports_dir}/trace.txt" }
dag      { enabled = true; file = "${params.reports_dir}/dag.svg" }
